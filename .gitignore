# =============================================================================
# DEHYPE .gitignore
# =============================================================================

# --- Environment Secrets & Credentials ---
.env
.env.*
!.env.example
*.env
*.env.local
frontend/.env.local
frontend/.env.*.local

# --- Video, Audio & Launch Production Artifacts ---
dehype-launch/
extracted_frames/
ref_breakdown/
ref_detailed/
video_analysis/
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wav
*.mp3
*.m4a
*.flac
*.aac
render_launch_film*.py
build_soundtrack*.py
generate_vo*.py
sync_vo.py
audio_builder.py

# --- Databases & Temporary Locks ---
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.dump
*.sql.gz
*.bak
platform_v2_backup_before_dedup.db
platform.db
live_news.db
pipeline_cache.db
frontend/*.db

# Whitelist the essential seeded production database
!platform_v2.db

# --- Legacy v1 Files (Superseded by React frontend) ---
/app.js
/style.css
/index.html

# --- One-off Historical Fix & Recovery Scripts ---
diagnose.py
inspect_missing.py
repair_arson.py
repair_sources.py
recover_cards.py
backfill_2026.py

# --- Ephemeral Caches, Logs & Scratch Dumps ---
logs/
audio_cache/
test_data/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
output_final.json
*.tmp
*.temp

# --- Python Runtime & Tooling Caches ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.nox/
*.egg-info/
dist/
build/
venv/
env/
.venv/

# --- Node & Frontend Build Artifacts ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
.vite/
.npm/
.pnpm-store/
*.tsbuildinfo

# --- Operating System & Editor Artifacts ---
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.swo
.vscode/
.idea/
*.code-workspace
